  "units": [
    { "type": "2BHK", "currency": "INR", "minPrice": 8900000, "maxPrice": 9600000, "interiorArea": 1050 },
    { "type": "3BHK", "currency": "INR", "minPrice": 11500000, "maxPrice": 12800000, "interiorArea": 1450 },
    { "type": "4BHK", "currency": "INR", "minPrice": 18500000, "maxPrice": 21000000, "interiorArea": 2200 }
  ]
}
```

> [!IMPORTANT]
> **Safety Net:** Your `updateProject` controller automatically sets `approval: 'pending'` and `status: 'inactive'` on every update (lines 40, 117-118). This means even after an automated update, the project **goes back into your normal approval queue** before it appears on the live site. Double human review.

### The Update Transformation Logic

```javascript
function buildUpdatePayload(stagedProject) {
  const { extracted_data, matched_project_id, price_change_diff } = stagedProject;
  
  // For "Apply Selected Updates" — only send changed fields
  const payload = {};
  
  for (const change of price_change_diff.changes) {
    if (change.field === 'possessionStatus') {
      payload.possessionStatus = extracted_data.possessionStatus;
    }
    if (change.field === 'possessionDate') {
      payload.possessionDate = extracted_data.possessionDate;
    }
    // ... other top-level fields
  }
  
  // Units are always sent as a complete array (your API does destroy + bulkCreate)
  if (price_change_diff.updated_fields.includes('units')) {
    payload.units = extracted_data.units;
  }
  
  // Media: only if new images were found
  if (price_change_diff.updated_fields.includes('medias')) {
    payload.medias = extracted_data.medias;
  }
  
  return {
    projectId: matched_project_id,  // The existing project to update
    payload
  };
}

// API call:
// PUT /project/{matched_project_id}
// Body: payload
```

