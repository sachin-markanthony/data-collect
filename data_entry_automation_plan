### The Transformation Logic:

```javascript
// In the approval endpoint or n8n workflow
function buildProductionPayload(stagedProject) {
  const { extracted_data, resolved_builder_id, resolved_city_id, resolved_location_id } = stagedProject;

  return {
    ...extracted_data,

    // Override with resolved UUIDs (human may have corrected these)
    builderId: resolved_builder_id,
    cityId: resolved_city_id,
    locationId: resolved_location_id,

    // System automation user (create a dedicated user for audit trail)
    uploadedBy: process.env.AUTOMATION_USER_ID,

    // Amenities: map extracted names to existing amenity IDs
    amenities: await mapAmenityNamesToIds(extracted_data.amenities),

    // Defaults
    transactionTag: extracted_data.transactionTag || 'sale',
    tags: extracted_data.tags || null,
  };
}
```

### Amenity Name → ID Resolution

Your `amenities` table has `{ id: INTEGER, name: STRING }`. The AI extracts names like `"Swimming Pool"`. We need to map them:

```javascript
async function mapAmenityNamesToIds(amenityNames = []) {
  if (!amenityNames.length) return [];

  const amenities = await Amenity.findAll({
    where: {
      name: { [Op.in]: amenityNames }
    },
    attributes: ['id', 'name']
  });

  // Return only IDs of amenities that exist in the master table
  return amenities.map(a => a.id);
}
```

